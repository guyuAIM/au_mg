---
import FaqContent from '../../../components/FaqContent.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { faqData, questionsPath } from '../../../lib/content.js';
import { faqPageSchema } from '../../../lib/schema.js';
import { faqAnswerText } from '../../../lib/faq-content.js';

const path = questionsPath;
const title = 'EV Questions & Answers | MG Australia';
const description = 'Practical answers about choosing, charging and owning an electric car, including prices, range, family space, running costs and warranty.';
const jsonLd = faqPageSchema({
  path,
  title,
  description,
  dateModified: faqData.modified,
  lastReviewed: faqData.reviewed,
  faqs: faqData.faqs.map((faq) => ({ id: faq.id, question: faq.question, answer: faqAnswerText(faq, faqData.faqs) }))
});
---
<BaseLayout {title} {description} {path} image="/assets/ev-guides-hero.png" view="questions" {jsonLd}>
  <FaqContent view="hub" />
</BaseLayout>
