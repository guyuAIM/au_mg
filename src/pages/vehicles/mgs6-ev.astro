---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqContent from '../../components/FaqContent.astro';
import { faqData } from '../../lib/content.js';
import { faqPageSchema } from '../../lib/schema.js';

const path = '/vehicles/mgs6-ev';
const title = 'MGS6 EV FAQs | MG Australia';
const description = 'Answers about MGS6 EV range, charging, space, ownership costs and family use.';
const faqs = faqData.faqs.filter((faq) => faq.models.includes('s6')).map((faq) => ({ question: faq.question, answer: [...faq.paragraphs, faq.note].filter(Boolean).join(' ') }));
const jsonLd = faqPageSchema({ path, title, description, faqs, vehicle: true });
---
<BaseLayout {title} {description} {path} image="/assets/mgs6-hero-desktop.jpg" view="s6" {jsonLd}>
  <FaqContent view="s6" />
</BaseLayout>
