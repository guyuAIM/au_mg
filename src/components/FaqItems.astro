---
import External from './External.astro';
import Icon from './Icon.astro';
import { faqData } from '../lib/content.js';
import { official } from '../lib/site.js';

const { faqs } = Astro.props;
const source = (id) => faqData.sources[id];
const offerExpired = new Date() > new Date(`${faqData.offerExpiry}T23:59:59+10:00`);
const formatDate = (value) => new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Australia/Sydney' }).format(new Date(`${value}T12:00:00+10:00`));
---
{faqs.map((faq) => (
  <article class="faq" id={faq.id} data-faq-item data-faq-kind={faq.audience === 'all-evs' ? 'general' : 'model'} data-category={faq.category} data-models={faq.models.join(' ')} data-search={`${faq.question} ${faq.keywords} ${faq.paragraphs.join(' ')} ${JSON.stringify(faq.table || '')}`}>
    <h3><button type="button" id={`trigger-${faq.id}`} aria-expanded="false" aria-controls={`answer-${faq.id}`} data-faq-trigger><span>{faq.question}</span><Icon name="down" /></button></h3>
    <div class="answer" id={`answer-${faq.id}`} aria-labelledby={`trigger-${faq.id}`} hidden>
      {faq.expiry && <div class="date-note">{offerExpired ? 'This September 2026 offer snapshot has expired. ' : `Prices checked ${formatDate(faqData.offerChecked)} · Offers end ${formatDate(faqData.offerExpiry)}. `}{offerExpired && <External href={official('/offers')}>View current MG offers</External>}</div>}
      {offerExpired && faq.expiry ? (
        <p>See the current offers page for available vehicles, prices and eligibility. The September promotion previously shown on this page is no longer presented as a current offer.</p>
      ) : (
        <>
          {faq.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {faq.table && <div class="table-wrap" tabindex="0" role="region" aria-label={`Comparison table for ${faq.question}`}><table><thead><tr>{faq.table.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead><tbody>{faq.table.rows.map((row) => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>}
          {faq.note && <p class="answer-note">{faq.note}</p>}
        </>
      )}
      <div class="sources"><strong>References</strong>{faq.sources.map((id) => <External href={source(id).url}>{source(id).title}<Icon name="out" /></External>)}</div>
    </div>
  </article>
))}
